# PostgreSQL connection string (Neon, Supabase, Railway, or local Docker)
DATABASE_URL="postgresql://user:password@host:5432/fitness_saarthi?sslmode=require"

# Long random string used to sign JWT auth tokens
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Optional — enables live AI Coach responses (Anthropic Claude).
# Without it, the coach replies in demo mode.
ANTHROPIC_API_KEY=""

# Public URL of the deployed app (used for metadata/links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
